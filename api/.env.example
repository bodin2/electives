# .env is not supported on production builds. Use environment variables in your deployment solution.
# See README.md for more information.

# Set to non-empty value to enable the dangerous admin endpoints
ADMIN_ENABLED=
# Set to non-empty value to reset admin user (ID 0) and password on startup
ADMIN_RESET=
ADMIN_SESSION_DURATION=3600
ADMIN_SESSION_CREATION_MINIMUM_TIME=3000

ARGON2_MEMORY=65536
ARGON2_AVG_TIME=500

USER_SESSION_CREATION_MINIMUM_TIME=500
USER_SESSION_DURATION=86400

NOTIFICATIONS_UPDATE_MAX_SUBSCRIPTIONS_PER_CLIENT=5
NOTIFICATIONS_BULK_UPDATE_INTERVAL=5000

HOST=127.0.0.1
PORT=8080

# Change this in production to your domain!
CORS_HOSTS="*"

# Set to non-empty value if behind a proxy (e.g. load balancer)
IS_BEHIND_PROXY=

DB_URL=jdbc:postgresql://localhost:5432/electives?tcpKeepAlive=true
DB_USER=electives
DB_PASSWORD=

# Optional connection-pool options
DB_POOL_SIZE=10
DB_MINIMUM_IDLE=10
DB_CONNECTION_TIMEOUT=10000
DB_MAX_LIFETIME=1800000
DB_IDLE_TIMEOUT=600000
DB_LEAK_DETECTION_THRESHOLD=0

# The service name reported to Grafana (service.name resource attribute)
OTEL_SERVICE_NAME=electives-api
# OTLP endpoint. Leave empty to disable all telemetry (metrics, traces, logs).

# For a local grafana/otel-lgtm container use the HTTP receiver on port 4318:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# For a hosted backend (e.g. Grafana Cloud) point the endpoint at the tenant URL and add auth headers:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceId:token)>
OTEL_EXPORTER_OTLP_ENDPOINT=
# How often Micrometer pushes metrics in milliseconds
OTEL_METRIC_EXPORT_INTERVAL=15000
